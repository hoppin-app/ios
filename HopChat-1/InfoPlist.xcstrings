    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Privacy - Bluetooth Always Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "hoppin uses Bluetooth to pass encrypted messages between nearby phones when there is no internet. Messages carried for other people cannot be read by this device."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "hoppin uses the camera to scan contact verification QR codes and to take photos you send in a chat."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O hoppin usa a câmara para ler códigos QR de verificação de contactos e para tirar fotografias que envia numa conversa."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "hoppin uses Face ID to unlock the app when you turn on app lock."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O hoppin usa o Face ID para desbloquear a aplicação quando ativa o bloqueio da app."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "hoppin uses the local network to deliver your encrypted messages directly to nearby hoppin users. Messages are also delivered through our relay server over the internet."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O hoppin usa a rede local para entregar as suas mensagens encriptadas diretamente a utilizadores do hoppin que estejam por perto. As mensagens também são entregues através do nosso servidor de retransmissão, pela Internet."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "hoppin saves photos you receive in a chat to your photo library."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O hoppin guarda na sua biblioteca de fotografias as fotos que recebe numa conversa."
          }
        }
      }
    }
  },
  "version" : "1.0"
}