        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As mensagens, fotografias e contactos ficam no seu iPhone. Nada legível é guardado fora dele, e apagar a sua conta elimina tudo."
          }
        }
      }
    },
