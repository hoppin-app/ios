          }
        }
      }
    },
    "On the same Wi-Fi, messages go straight to the other phone and the server sees nothing at all." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the same Wi-Fi, messages go straight to the other phone and the server sees nothing at all."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na mesma rede Wi-Fi, as mensagens vão diretamente para o outro telemóvel e o servidor não vê absolutamente nada."
          }
        }
      }
    },
    "On the same Wi-Fi, messages hop straight from device to device. Otherwise a relay holds them sealed until you pick them up, and the people running it cannot read them." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the same Wi-Fi, messages hop straight from device to device. Otherwise a relay holds them sealed until you pick them up, and the people running it cannot read them."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na mesma rede Wi-Fi, as mensagens saltam diretamente de dispositivo para dispositivo. Caso contrário, um servidor de retransmissão guarda-as seladas até que as recolha, e quem o gere não as consegue ler."
          }
        }
      }
    },
