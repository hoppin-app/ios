    },
    "With no Wi-Fi and no mobile data, hoppin can pass a message to nearby phones over Bluetooth until it reaches the person you sent it to. It is switched on only while you are offline." : {
      "comment" : "A description of Bluetooth mesh.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem Wi-Fi e sem dados móveis, o hoppin pode passar uma mensagem a telemóveis por perto através de Bluetooth até esta chegar à pessoa a quem a enviou. Só é ativado enquanto estiver offline."
          }
        }
      }
    },
