          }
        }
      }
    },
    "Off by default. Your messages stay end-to-end encrypted and the operator cannot read them unless you turn this on." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off by default. Your messages stay end-to-end encrypted and the operator cannot read them unless you turn this on."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativado por predefinição. As suas mensagens continuam encriptadas de ponta a ponta e o operador não as consegue ler a menos que ative esta opção."
          }
        }
      }
    },
    "Offers spelling corrections as you write, using the dictionaries already on this device. Nothing you type is sent anywhere." : {
      "localizations" : {
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sugere correções ortográficas enquanto escreve, usando os dicionários já presentes neste dispositivo. Nada do que escreve é enviado para lado nenhum."
          }
        }
      }
    },
