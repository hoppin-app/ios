          }
        }
      }
    },
    "Whether what you send is a message or just a receipt or update, since only messages show a notification on the other phone." : {
      "comment" : "Something the relay can tell about what you send: it only pushes for messages.",
      "localizations" : {
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
