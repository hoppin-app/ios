          }
        }
      }
    },
    "hoppin needs their encryption key before a safety number exists. Send them a message, or refresh below." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "hoppin needs their encryption key before a safety number exists. Send them a message, or refresh below."
          }
