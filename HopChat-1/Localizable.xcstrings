          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não consegue ler as suas mensagens, ver as suas fotografias nem saber o que escreveu. Tudo é selado com chaves que só você e a pessoa a quem escreve possuem."
          }
        }
